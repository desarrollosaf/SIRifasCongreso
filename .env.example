# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.

# Acceso al panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# Base de datos MySQL del contenedor
MYSQL_ROOT_PASSWORD=cambia-root
RIFAS_DB_NAME=congresoedomex_rifas
RIFAS_DB_USER=usr_rifas
RIFAS_DB_PASSWORD=cambia-usuario

# Segundos que dura la animación "sorteando" en la pantalla pública (en milisegundos)
DURACION_SORTEO_MS=3000

# La base de usuarios SAF vive dentro del MariaDB de Docker (adminplem_saf).
# Se carga/actualiza subiendo un .sql desde Admin → Participantes.
